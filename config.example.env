# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# --- Talker (fast model, API) ---
# Provider is swappable: anthropic | gemini | groq
JARVIS_TALKER_PROVIDER=anthropic
JARVIS_TALKER_MODEL=
# Comma-separated models tried in order if the main one is overloaded (defaults per provider)
JARVIS_TALKER_FALLBACK_MODELS=
# Comma-separated providers tried when the primary one fails entirely, e.g. gemini.
# Each uses its own default models and prices; providers without a key are skipped.
# Careful: the Gemini free tier may use what you send.
JARVIS_TALKER_FALLBACK_PROVIDERS=
ANTHROPIC_API_KEY=
# Gemini free tier: testing only (prompts may be used by Google)
GEMINI_API_KEY=
# Groq free tier (check its data and rate-limit pages before relying on it)
GROQ_API_KEY=
# How hard the Groq gpt-oss models think: low (default, fast) | medium | high. Deeper = slower and spends more
# of the per-minute token limit; measured 2026-10-11: not reliably better for reminders, so keep low unless testing.
JARVIS_GROQ_REASONING=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Numeric user id(s) allowed to talk to the bot, comma-separated
TELEGRAM_ALLOWED_USER_IDS=

# Optional overrides (defaults: Haiku 4.5 reference prices for anthropic, free for gemini).
# Prices are USD per million tokens.
JARVIS_PRICE_IN_PER_MTOK=
JARVIS_PRICE_OUT_PER_MTOK=

# --- Mind vault ---
# Root of the vault. The assistant reads the pending tasks from here (read-only).
# Default: ~/projetos/mind
JARVIS_MIND_DIR=
# The only place the assistant writes (default: <mind dir>/inbox/jarvis)
JARVIS_INBOX_DIR=

# --- Cost guards ---
# Daily spending cap for the Talker, in USD; the core stops calling the API above it
JARVIS_DAILY_BUDGET_USD=

# --- Google Calendar (optional; without it the agenda tools are simply off) ---
# One service account reads and writes every calendar shared with it ("make changes to events").
# key=calendar id, comma-separated. The keys the assistant understands: trabalho, pessoal, cafe.
JARVIS_CALENDARS=
# Path of the service account's JSON key (default: state/google-service-account.json, outside git)
JARVIS_GOOGLE_CREDENTIALS=
# Calendar id of a separate calendar (e.g. "Jarvis · tarefas", shared with the service account with "make changes to events")
# where the day's tasks appear as all-day items. Empty = off. Find it in the calendar's settings, "Integrate calendar".
JARVIS_TASKS_CALENDAR=
