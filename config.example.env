# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# --- Talker (fast model, API) ---
# Provider is swappable: anthropic | gemini | groq
JARVIS_TALKER_PROVIDER=anthropic
JARVIS_TALKER_MODEL=
# Comma-separated models tried in order if the main one is overloaded (defaults per provider)
JARVIS_TALKER_FALLBACK_MODELS=
ANTHROPIC_API_KEY=
# Gemini free tier: testing only (prompts may be used by Google)
GEMINI_API_KEY=
# Groq free tier (check its data and rate-limit pages before relying on it)
GROQ_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Numeric user id(s) allowed to talk to the bot, comma-separated
TELEGRAM_ALLOWED_USER_IDS=

# Optional overrides (defaults: Haiku 4.5 reference prices for anthropic, free for gemini).
# Prices are USD per million tokens.
JARVIS_PRICE_IN_PER_MTOK=
JARVIS_PRICE_OUT_PER_MTOK=

# --- Vault inbox (the assistant only writes here) ---
# Default: ~/projetos/mind/inbox/jarvis
JARVIS_INBOX_DIR=

# --- Cost guards ---
# Daily spending cap for the Talker, in USD; the core stops calling the API above it
JARVIS_DAILY_BUDGET_USD=
